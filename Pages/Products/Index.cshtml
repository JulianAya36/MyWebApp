@page
@model MyWebApp.Pages.Products.IndexModel
@using MyWebApp.Data
@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">📦 Lista de Productos</h1>
        <a asp-page="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Producto
        </a>
    </div>

    @if (Model.Products == null || !Model.Products.Any())
    {
        <div class="alert alert-warning text-center">
            No hay productos registrados todavía.
        </div>
    }
    else
    {
        <table class="table table-hover table-striped align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>$@item.Price.ToString("N2")</td>
                        <td class="text-center">
                            <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                            <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-2 text-white">
                                <i class="bi bi-info-circle"></i> Detalles
                            </a>
                            <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
